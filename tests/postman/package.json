{
  "name": "maily-system-api-e2e",
  "private": true,
  "description": "Herramientas de desarrollo para ejecutar la colección de Postman; no forman parte del servicio.",
  "scripts": {
    "e2e": "newman run collections/MailySoft-System-Suscripciones.postman_collection.json -e environments/e2e.postman_environment.json -r cli,junit --reporter-junit-export reports/junit.xml --timeout-request 15000",
    "e2e:dashboard": "newman run collections/MailySoft-System-Dashboard.postman_collection.json -e environments/e2e.postman_environment.json -r cli,junit --reporter-junit-export reports/junit-dashboard.xml --timeout-request 15000",
    "e2e:health": "newman run collections/MailySoft-System-Salud.postman_collection.json -e environments/e2e.postman_environment.json -r cli,junit --reporter-junit-export reports/junit-health.xml --timeout-request 15000",
    "e2e:all": "npm run e2e && npm run e2e:dashboard && npm run e2e:health"
  },
  "devDependencies": {
    "newman": "6.2.3"
  }
}
