# Copiar a `.env` (no versionado) y ajustar si hace falta.
# Si cambias POSTGRES_PORT, cambia también el puerto en las dos URLs.

# Puerto del host publicado por el servicio `db` de docker-compose.yml.
# 5434 para no chocar con las bases de datos de otros proyectos MailySoft (5432 y 5433).
POSTGRES_PORT=5434

# Base de datos de la aplicación y de las migraciones
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/maily_system

# Base de datos de las pruebas. Las pruebas ELIMINAN y recrean el esquema, por eso
# el nombre de la base DEBE terminar en `_test` (si no, la suite se niega a ejecutarse).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/maily_system_test

# Puerto del host publicado por el servicio `api` de docker-compose.yml
API_PORT=8010

# --- APIs de los que depende este servicio ---
# Este servicio NO verifica los tokens: reenvía el token de la persona al API de usuarios (permisos)
# y al API de clínicas (conteo de clínicas por suscripción). Sin las dos direcciones el arranque se
# niega a iniciar. Las pruebas automatizadas NO las necesitan: usan simulaciones (tests/stubs/).
# Usa `https://` salvo en local o en la red de Docker, porque a esas direcciones se reenvía el token
# de la persona; con `http://` no local el servicio arranca pero registra una advertencia.

# Dirección base del API de usuarios, sin barra final (por ejemplo: http://localhost:8000)
USERS_API_BASE_URL=
# Dirección base del API de clínicas, sin barra final
CLINICS_API_BASE_URL=

# Opcionales (se muestran con su valor por defecto):
# Tiempo máximo total, en segundos, de cada llamada al API de usuarios (mayor que 0 y hasta 30)
# USERS_API_TIMEOUT_SECONDS=5
# Tiempo máximo total, en segundos, de cada llamada al API de clínicas (mayor que 0 y hasta 30)
# CLINICS_API_TIMEOUT_SECONDS=5
# Sitios web del Front que pueden llamar a la API desde el navegador, separados por comas.
# Sin esta variable no se permite ningún sitio web.
# CORS_ALLOWED_ORIGINS=
# Cantidad de clínicas recientes que devuelve el dashboard de plataforma cuando la persona no envía
# `limit`. Valores admitidos: 3, 5 o 10 (cualquier otro impide arrancar el servicio). Por defecto: 5.
# Un cambio requiere reiniciar el servicio.
# DASHBOARD_RECENT_CLINICS_LIMIT=5
